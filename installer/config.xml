<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>Kids Mode</Name>
    <Version>1.0.0</Version>
    <Title>Kids Mode</Title>
    <Publisher>Kids Mode</Publisher>
    <WizardStyle>Modern</WizardStyle>
    <!-- Per-user install: the parent runs this while logged in as the child, unelevated. -->
